<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- base defining macro -->
  <xacro:macro name="base" params="wheel_radius namespace">
    <link name="${namespace}_base_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.1" />
        </geometry>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0" />
      </visual>

      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="0.1" />
        </geometry>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0" />
      </collision>

      <inertial>
        <mass value="1.0" />
        <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                  iyy="0.1" iyz="0.0"
                  izz="0.1" />
      </inertial>
    </link>
  </xacro:macro>

</robot>